# Editor / OS local files
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*~

# Build directories
build/
cmake-build-*/

# C/C++ build artifacts
*.o
*.d
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe

# Main binaries generated by Makefile
/kvstore
/src/eBPF/ebpf_syncd

# Build output directory (all test binaries, libs, obj output here)
/build/

# Test runtime artifacts (legacy locations in tests/)
/tests/**/*.log
/tests/**/*.tmp
/tests/**/*.pid
/tests/**/*.rdb
/tests/**/*.aof
/tests/**/*.dat
/tests/**/*.gcda
/tests/**/*.gcno
/tests/**/*.profraw
/tests/**/*.profdata
/tests/**/core

# eBPF generated files
/src/eBPF/*.o
/src/eBPF/vmlinux.h
/src/eBPF/vmlinux.h.kver

# Local persistence / runtime data
/data/
*.rdb
*.aof
*.dat
*.pid
/core
/core.*

# Logs and benchmark outputs generated locally.
# Some historical logs/results are already tracked; this prevents new ones.
/logs/**/*.log

# Ignore everything in results/ except designated summary files.
# Historically-tracked files are NOT affected by these rules.
/results/**
!/results/summary.md
!/results/vector_rw_summary.md

# Vendored/generated dependency outputs
/third_party/onnxruntime/
/third_party/libbpf/**/*.o
/third_party/libbpf/**/*.so*
/third_party/NtyCo/objs/
/third_party/NtyCo/libntyco.a

# Local embedding / model artifacts. Do not commit model weights.
/models/

# jemalloc generated build/install outputs
/third_party/jemalloc/lib/
/third_party/jemalloc/bin/
/third_party/jemalloc/share/
/third_party/jemalloc/Makefile
/third_party/jemalloc/config.log
/third_party/jemalloc/config.status
/third_party/jemalloc/jemalloc.pc
/third_party/jemalloc/include/jemalloc/jemalloc.h

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# One-time analysis data
git_iteration_data/

# AI tool configs
.claude/
.agents/
.codex/
